# Public native trust is configured in ios-ota.public.json, never in browser VITE env.
# Private key is a local file, excluded from Git. Never upload it to Cloudflare.
OTA_PRIVATE_KEY_FILE=.ota-private/manifest-ed25519.pem
OTA_VERSION=1.4.75-beta.202610200001
OTA_MIN_BUILD=3
OTA_MAX_BUILD=3
OTA_ROLLOUT_PERCENT=0
OTA_RELEASE_NOTES=Describe the tested interface changes
OTA_STOP=false
# Publishing only; use dedicated R2 credentials restricted to the update bucket.
OTA_R2_BUCKET=updatelccms
R2_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set only when the owner explicitly authorizes publication:
OTA_PUBLISH_CONFIRM=
